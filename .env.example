# ---- whatsapp-bridge ------------------------------------------------
# Copy to .env (never committed). Every value has a default except the ones
# marked "required when". Values are quoted so this file is also safe to
# `source` from a shell script (durations contain spaces).

# Where the linked WhatsApp session and other runtime files live.
# The session credentials are written under $BRIDGE_DATA_DIR/auth with mode 0700;
# the bridge's SQLite file is $BRIDGE_DATA_DIR/bridge.db (0600), or BRIDGE_DATABASE_PATH.
BRIDGE_DATA_DIR="./data"
# BRIDGE_DATABASE_PATH="./data/bridge.db"

# Record every message in both directions, searchable, forever. Off by default.
# Run `bridge history enable` once on this machine before turning it on.
BRIDGE_HISTORY="false"

# Local HTTP API the daemon exposes (Intro talks to this).
BRIDGE_HOST="127.0.0.1"
BRIDGE_PORT="8787"

# Optional bearer token. When set, every endpoint except GET /health requires
# "Authorization: Bearer <token>". Leave unset on a trusted machine.
# BRIDGE_API_TOKEN=

# Who answers a turn:
#   manual - Intro subscribes to GET /events and answers with POST /turns/{id}/reply (default)
#   http   - the bridge POSTs each turn to INTRO_HANDLER_URL and sends whatever comes back
#   pong   - the built-in harness responder (what `bridge harness` uses)
BRIDGE_RESPONDER="manual"

# Required when BRIDGE_RESPONDER=http.
# INTRO_HANDLER_URL="http://127.0.0.1:9000/turn"
# INTRO_HANDLER_TIMEOUT="120 seconds"

# Messages from one chat that arrive within this window are batched into one turn.
BRIDGE_BATCH_WINDOW="1500 millis"

# A turn opens at most this long after its oldest message, even if messages keep coming.
BRIDGE_BATCH_MAX_WAIT="5 seconds"

# While the sender is still typing, the window may stretch this long instead (from the oldest message).
BRIDGE_BATCH_TYPING_WAIT="15 seconds"

# In manual mode, how long the bridge waits for Intro's reply before the turn fails.
BRIDGE_TURN_TIMEOUT="10 minutes"

# The "seen" reaction. Removed after the reply goes out.
BRIDGE_SEEN_EMOJI="👀"

# If the reaction cannot be applied after retries, send this text instead (optional).
# BRIDGE_SEEN_FALLBACK_TEXT="seen — working"

# Mark every accepted message as read (blue ticks; the phone's privacy setting decides whether they show).
BRIDGE_READ_RECEIPTS="true"

# Sent as a quoted reply to the newest message when a turn fails, times out or is abandoned. Empty disables.
BRIDGE_FAILURE_TEXT="Something went wrong."

# How long "typing…" is kept alive per turn (re-sent every 8 s); each progress call re-arms it.
BRIDGE_TYPING_MAX="3 minutes"

# Handle group chats (default: DMs only).
BRIDGE_GROUPS="false"

# What opens a turn in a group: mention (the bridge is @-mentioned or one of its messages is quoted)
# or always (every message, as in a DM). Other group messages are context only.
BRIDGE_GROUP_TRIGGER="mention"

# Comma-separated phone numbers (digits) or jids allowed to talk to the line.
# Unset means anyone may message the number and Intro replies as the assistant.
# With BRIDGE_OWNER set, a person unlocks their DM only and a group jid unlocks that group.
# BRIDGE_ALLOWED_SENDERS="447700900123,447700900456"

# ---- the owner and the observer -------------------------------------
# Your own number (digits). Turns the access rule on: your DM, groups you are in, and the
# allowlist get replies; nothing else can be sent to. Your DM turns may read the observer.
# BRIDGE_OWNER="447700900123"

# The observer: `bridge observe enable`, `observe link` (scan with YOUR phone), `observe run`.
# Its own directory (session, database, media, acceptance) and its own port; health and attachments only.
BRIDGE_OBSERVER_DIR="./data-observer"
BRIDGE_OBSERVER_PORT="8788"
# BRIDGE_OBSERVER_URL="http://127.0.0.1:8788"
# Keep the recent history WhatsApp pushes at link time, this many days back (0 refuses it all).
BRIDGE_OBSERVE_BACKFILL_DAYS="30"
# Observed rows older than this are purged daily.
BRIDGE_OBSERVE_RETENTION="180 days"
# Chats the observer never writes to disk (jids or digits).
# BRIDGE_OBSERVE_EXCLUDE="447700900999,120363000000000000@g.us"

# Messages delivered while the bridge was offline are normally ignored (WhatsApp
# replays them on reconnect). Set a window to handle the ones younger than it.
BRIDGE_OFFLINE_WINDOW="0 seconds"

# Attachments. Downloaded files live under BRIDGE_MEDIA_DIR (default <data dir>/media),
# 0600 in 0700 directories, under the BRIDGE_MEDIA_MAX_DISK budget below.
# BRIDGE_MEDIA_MAX_BYTES caps both incoming downloads and files Intro sends out.
# BRIDGE_MEDIA_AUTO: which kinds are fetched before a turn opens: images (image+sticker) | all | none.
# Anything else is fetched on demand via GET /chats/{chat}/messages/{id}/media.
# BRIDGE_MEDIA_DIR="./data/media"
BRIDGE_MEDIA_AUTO="images"
BRIDGE_MEDIA_MAX_BYTES="26214400"
BRIDGE_MEDIA_WAIT="8 seconds"
# Disk budget for downloaded files; least recently used are evicted past it. Optional maximum age on top.
BRIDGE_MEDIA_MAX_DISK="1073741824"
# BRIDGE_MEDIA_RETENTION="30 days"
BRIDGE_MEDIA_SWEEP_EVERY="1 hour"

# Show "typing…" while a turn is being answered.
BRIDGE_TYPING="true"

# Logging. Bodies are never logged at Info; LOG_BODIES=true logs them at Debug.
LOG_LEVEL="Info"
LOG_FORMAT="pretty"
LOG_BODIES="false"

# The WhatsApp protocol library's own logger, forwarded (redacted) into the bridge's logs.
# One of trace|debug|info|warn|error|silent. warn shows its reconnect and decrypt problems.
BAILEYS_LOG_LEVEL="warn"

# Name shown in WhatsApp's "Linked devices" list.
WA_BROWSER_NAME="Intro Bridge"

# Used by the CLI client commands (health, send, react) to reach the daemon.
# Defaults to http://$BRIDGE_HOST:$BRIDGE_PORT
# BRIDGE_URL="http://127.0.0.1:8787"
