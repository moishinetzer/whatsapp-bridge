{
  "name": "whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp <-> Intro bridge: a local daemon on a dedicated number, built on Effect v4 and Baileys",
  "type": "module",
  "bin": {
    "bridge": "./bin/bridge.js"
  },
  "scripts": {
    "bridge": "tsx src/main.ts",
    "link": "tsx src/main.ts link",
    "start": "tsx src/main.ts run",
    "harness": "tsx src/main.ts harness",
    "health": "tsx src/main.ts health",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "effect": "4.0.0-rc.109",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@types/node": "^22",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp"
    ]
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/moishinetzer/whatsapp-bridge.git"
  }
}
